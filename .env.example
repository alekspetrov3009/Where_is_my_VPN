# ============================================================
# Where is my VPN — переменные окружения
# Скопируйте в .env и при необходимости измените значения.
# Все переменные необязательны: без .env используются значения по умолчанию.
# ============================================================

# ---------- Сервер ----------
# Порт веб-сервера (в docker-compose левая часть ports берётся отсюда)
VPN_SERVER_PORT=8079
# Адрес привязки сервера (в контейнере должен быть 0.0.0.0)
VPN_SERVER_HOST=0.0.0.0
# Путь админ-панели (сделайте менее очевидным для публичного сервера)
VPN_ADMIN_PATH=/vpn-control-panel-x7k9
# Учётные данные админ-панели — ОБЯЗАТЕЛЬНО смените пароль на публичном сервере
VPN_ADMIN_USER=admin
VPN_ADMIN_PASSWORD=vpn2026
# Открывать браузер при старте (1 — да, 0 — нет; в Docker всегда 0)
VPN_OPEN_BROWSER=0

# ---------- Сборка образа ----------
# Откуда Docker берёт код при сборке:
#   не задано — URL репозитория (по умолчанию), локальные исходники не нужны;
#   .         — из локальной папки (нужен весь код рядом с compose);
#   URL#тег   — закреплённая версия репозитория.
# Локальная сборка нужна, если хотите положить свой sing-box в sing-box-bin/
# или собрать с неопубликованными правками.
#VPN_BUILD_CONTEXT=.

# ---------- Пути ----------
# Каталог изменяемых данных: пул, .singbox_config.json, чекпоинты.
# Пусто = каталог приложения. В контейнере фиксируется /data (volume).
#VPN_DATA_DIR=
# Каталог с бинарником sing-box. Пусто = ./sing-box-bin
#VPN_SINGBOX_DIR=

# ---------- Проверка: таймауты и лимиты ----------
# Основной URL проверки VPN-канала
#VPN_TEST_URL=http://cp.cloudflare.com
# Резервный URL проверки
#VPN_TEST_URL_FALLBACK=http://connectivitycheck.gstatic.com/generate_204
# Таймаут одного URL, секунды (полный проход)
#VPN_CHECK_TIMEOUT=6.0
# Таймаут одного URL, секунды (быстрый проход)
#VPN_FAST_CHECK_TIMEOUT=2.5
# Параллельных sing-box процессов при поиске
#VPN_CHECK_CONCURRENCY=16
# Параллельных проверок сервисов. Каждый сервер проверяется на 4 сервиса
# (ChatGPT/YouTube/Telegram/Instagram) параллельно, поэтому фактическая
# нагрузка — SERVICE_CONCURRENCY * 4 одновременных HTTPS-запросов.
#VPN_SERVICE_CONCURRENCY=6
# Параллельных воркеров перепроверки пула
#VPN_POOL_CONCURRENCY=3
# Период перепроверки рабочих конфигов, секунды
#VPN_POOL_RECHECK_SECONDS=600
# Период повторного замера скорости, секунды
#VPN_SPEED_RECHECK_SECONDS=10800
# Размер батча поиска, конфигураций
#VPN_DISCOVERY_BATCH_SIZE=200
# Объём тестовой загрузки при замере скорости, байт
#VPN_SPEED_BYTES=5242880
# Таймаут замера скорости, секунды
#VPN_SPEED_TIMEOUT=15
# Повторы полной проверки при таймауте
#VPN_CHECK_RETRIES_ON_TIMEOUT=0
# Таймаут проверки страницы сервиса (ChatGPT), секунды
#VPN_SERVICE_TIMEOUT=10
# Проверка QUIC/HTTP3 через туннель. hysteria2 и tuic работают поверх UDP,
# и ТСПУ часто режет именно UDP: сервер с хорошим TCP-пингом может не
# пропускать QUIC. Пустое значение отключает проверку.
#VPN_QUIC_TEST_URL=https://cloudflare-quic.com/
#VPN_QUIC_TIMEOUT=10
# Геопроверка через ip-api.com: страна и ASN сервера. Серверы с российским
# IP помечаются флагом is_ru — для обхода блокировок они бесполезны, так как
# трафик не выходит за периметр ТСПУ. VPN_GEOIP_ENABLED=0 отключает внешние
# запросы (тогда поле geo в пуле не заполняется).
#VPN_GEOIP_ENABLED=1

# ---------- Пул ----------
# Успешных проверок подряд до статуса "стабильный"
#VPN_STABLE_CHECKS=2
# Кэш заведомо нерабочих точек, секунды. Каталог содержит десятки тысяч
# конфигураций, и большинство мертвы: без кэша каждый проход заново тратит на
# них полный таймаут. Протухшие записи перепроверяются. 0 отключает кэш.
#VPN_DEAD_CACHE_SECONDS=21600
# Ограничение перекоса по источникам: во сколько раз вес источника может
# превышать вес самого маленького. Вес = корень из числа конфигураций.
# Без ограничения один агрегатор на 15 000 конфигураций забирал бы ~25%
# каждого пула. 0 — без ограничения (чистая пропорция).
#VPN_SOURCE_WEIGHT_CAP=4.0

# ---------- Один ключ (подписка / sing-box urltest) ----------
# Максимум серверов в ключе с автопереключением (/api/onekey).
# Формат: base64-подписка по умолчанию; ?format=json или User-Agent
# sing-box/SFA/SFI/SFM/SFT/Hiddify — sing-box JSON с urltest;
# ?format=clash или User-Agent clash/mihomo — Clash/Mihomo YAML.
#VPN_ONEKEY_LIMIT=20
# Порт mixed-инбаунда в генерируемом конфиге (локальный прокси клиента)
#VPN_ONEKEY_MIXED_PORT=2080
# Секретный токен /api/onekey; пусто = без токена. На публичном сервере
# ОБЯЗАТЕЛЬНО задайте свой токен: /api/onekey?token=<значение>
#VPN_ONEKEY_TOKEN=

# ---------- Каталог источников ----------
# TTL суточного каталога, секунды
#VPN_CATALOG_REFRESH_SECONDS=86400
# Параллельная загрузка файлов списков
#VPN_CATALOG_DOWNLOAD_CONCURRENCY=4
# Базовый URL каталога Goida VPN
#VPN_GOIDA_BASE_URL=https://raw.githack.com/AvenCores/goida-vpn-configs/main/githubmirror/

# ---------- sing-box ----------
# Версия sing-box для авто-скачивания
#VPN_SINGBOX_VERSION=1.10.3
# Зеркала GitHub через запятую; ПУСТОЙ элемент = официальный GitHub
#VPN_GITHUB_MIRRORS=https://ghfast.top/,https://mirror.ghproxy.com/,https://gh-proxy.com/,
